.blue {
    background: linear-gradient(54.03deg, #00DED1 0%, #0282F9 99.83%);
    width: 95%;
    margin: 90px auto 150px;
    border-radius: 50px;
}
.color-blue{ background: linear-gradient(54.03deg, #00DED1 0%, #0282F9 99.83%);
    padding-top: 2em;
    padding-bottom: 0em;}
.blue-slide{transform: skewY(-5deg); position: relative;}
.page-id-6393{
background-color: #fff;}
.sec-3, .sec-6{position: relative;
    border-radius: 50px;
    transform: skewY(-5deg);
    width: 95%;
    max-width: 1766px;
    margin: 0 auto 10rem;}


.build-sec{
    transform: skewY(5deg);}

.bg-blue {
    background-color: #2E3D62;
}
.bg-white, .text-white{
color: #fff;}
.right-connect-icons {
    position: fixed;
    top: 40%;
    right: 0%;
    text-align: center;
    width: 100px;
    z-index: 999;
}

.right-connect-icons ul li {
    padding: 15px 4px;
    line-height: 1.3;
    transition: .3s ease-in-out;
    font-size: 14px;
    border-bottom: 1px solid #fefefe2b;
color: #fff;
}
.right-connect-icons .fa {
    color: #fff;
}
.right-connect-icons ul {
    list-style: none;
    margin: 0;
}

.img-box {
    margin: 0 15px;
}
.img-box .elementor-widget-wrap{
    transition: all 5s ease-in-out !important;
}
.slide-box .img-box:hover .elementor-widget-wrap {
    background-position: bottom !important;
    cursor: pointer;
    transition: all 5s ease-in-out !important;
}
.slide-box {
    transition: all 5s ease-in-out !important;
    border: 5px solid #fff;
    border-radius: 10px;
    box-shadow: 0 15px 25px #EDF8F8;
    background-position: top !important;
transition: all 5s ease-in-out;
    margin: 15px;
}

.slide-box .img-box:hover .elementor-widget-wrap {
    background-position: bottom !important;
    cursor: pointer;
    transition: all 5s ease-in-out !important;
}

i.fab.fa-whatsapp.web:hover {color: #fff;}

@media only screen and (max-width: 1024px) {
.blue {
    margin: 40px auto 80px;
}
}

@media only screen and (max-width: 767px) {
.slide-box {
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.5);
}
.right-connect-icons {
    display: none;
}

/*CRM PAge*/
.sec-3{position: relative;
    border-radius: 0px;
    transform: skewY(-5deg);
    width: 100%;
    max-width: 100%;
    margin: 0;}

.build-sec{
    transform: skewY(5deg);}

.blue {
    margin: 30px auto 60px;
}
